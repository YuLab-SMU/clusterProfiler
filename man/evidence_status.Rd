% Generated by hand to match the roxygen block in R/interpret.R; regenerate with document().
\name{evidence_status}
\alias{evidence_status}
\title{Evidence status of every gene named in an interpretation}
\usage{
evidence_status(
  x,
  enrichment,
  OrgDb = NULL,
  symbols = NULL,
  fields = c("overview", "key_mechanisms", "regulatory_drivers", "crosstalk", "hypothesis",
    "narrative", "reasoning", "network_evidence")
)
}
\arguments{
\item{x}{An \code{interpretation} or \code{interpretation_list} returned by \code{\link[=interpret]{interpret()}},
\code{\link[=interpret_agent]{interpret_agent()}} or \code{\link[=interpret_hierarchical]{interpret_hierarchical()}}.}

\item{enrichment}{The \code{enrichResult}, \code{compareClusterResult}, \code{gseaResult} or data.frame
the interpretation was produced from (readable, so that member genes are symbols).}

\item{OrgDb}{Optional \code{OrgDb} used to recognise out-of-evidence symbols. Without it, only
tokens that look like gene symbols and appear in \code{symbols} are considered.}

\item{symbols}{Optional character vector of valid gene symbols (alternative to \code{OrgDb}).}

\item{fields}{Record fields to scan.}
}
\value{
A data.frame with columns \code{cluster}, \code{field}, \code{gene} and \code{status}.
}
\description{
Deterministically classifies each gene symbol that an interpretation names as
\code{observed} (a member gene of the enrichment result it was given) or \code{out_of_evidence}
(a valid symbol that is not). No model is called. Use it to label hypotheses from
\code{\link[=interpret_agent]{interpret_agent()}} as inferred rather than observed: unlike a second model, this check
is exact and cannot also mark grounded genes as uncertain.
}
